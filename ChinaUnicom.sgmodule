#!name=中国联通组件服务（本地修正）
#!desc=获取中国联通 Cookie 写入 BoxJS ComponentService
#!category=组件服务
#!author=ByteValley & cc166

[Script]
联通组件 = type=http-request, pattern=^https:\/\/m\.client\.10010\.com\/(mobileserviceimportant\/home\/queryUserInfoSeven|servicequerybusiness\/operationservice\/queryOcsPackageFlowLeftContent|.*\/smartwisdomCommon), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Scripts/Component/ChinaUnicom.js, script-update-interval=0

[MITM]
hostname = %APPEND% m.client.10010.com
